# Copy to .env and fill in. Never commit .env.
# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Mapbox token for place search when picking meeting points.
# Without it the app falls back to the device geocoder (expo-location).
EXPO_PUBLIC_MAPBOX_TOKEN=

# Optional: public base URL used in share links (falls back to the masar:// scheme).
EXPO_PUBLIC_SHARE_BASE_URL=

# EAS project id — required for Expo push tokens (run `npx eas-cli init`).
EXPO_PUBLIC_EAS_PROJECT_ID=

# DB tests only: a Postgres server with PostGIS where the tests may create databases.
# With `supabase start` running: postgres://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=
